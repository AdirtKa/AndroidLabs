<resources>

    <!-- Заголовки -->
    <style name="MyTitleText">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Обычный текст -->
    <style name="MyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/light_gray</item>
    </style>

    <!-- Поле ввода -->
    <style name="MyEditTextStyle">
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/light_gray</item>
        <item name="android:backgroundTint">@color/teal_200</item>
    </style>

    <!-- Кнопки -->
    <style name="MyMaterialButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Карточка/контейнер -->
    <style name="MyCard">
        <item name="android:padding">16dp</item>
        <item name="android:background">@color/black</item>
    </style>

</resources>
