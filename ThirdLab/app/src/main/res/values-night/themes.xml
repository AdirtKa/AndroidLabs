<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Тёмная тема приложения -->
    <style name="Theme.ThirdLab" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвета фона -->
        <item name="android:colorBackground">@color/dark_gray</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Для Material Components -->
        <item name="materialButtonStyle">@style/MyMaterialButtonStyle</item>
    </style>

</resources>
